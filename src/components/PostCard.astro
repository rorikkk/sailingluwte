---
import { excerpt, formatDate, type Post } from '../lib/utils';
interface Props { post: Post }
const { post } = Astro.props;
---
<div role="listitem" class="blog-preview-wrap w-dyn-item">
  <a href={`/blog/${post.id}/`} class="link-block w-inline-block">
    <div class="w-layout-blockcontainer container-4 w-container">
      <div class="w-layout-layout quick-stack wf-layout-layout">
        <div class="w-layout-cell cell">
          <div class="label cc-blog-date">{formatDate(post.data.date)}</div>
        </div>
        <div class="w-layout-cell cell-3">
          <h1 class="article-heading">{post.data.title}</h1>
          <p class="paragraph-light summary">{excerpt(post)}</p>
        </div>
      </div>
    </div>
  </a>
</div>
