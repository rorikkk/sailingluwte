---
import Base from '../layouts/Base.astro';
---
<Base title="Not Found" wfPage="65202d762b2142649c9d285c" chrome={false}>
  <Fragment slot="head">
    <meta content="Not Found" property="og:title">
    <meta content="Not Found" name="twitter:title">
  </Fragment>
  <div class="utility-page-wrap">
    <div class="_404-wrap">
      <div class="_404-content-wrap">
        <div class="heading-jumbo">Page Not Found</div>
        <div class="paragraph-bigger cc-bigger-light">The page you are looking for doesn't exist or has been moved.</div>
      </div>
      <a href="/" class="button cc-white-button w-inline-block">
        <div>Go Back to Safety</div>
      </a>
    </div>
  </div>
</Base>
