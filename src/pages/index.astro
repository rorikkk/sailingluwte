---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Destination from '../components/Destination.astro';
import home from '../data/home.json';
import destinations from '../data/destinations.json';
import { getPosts, rich } from '../lib/utils';
const posts = await getPosts();
---
<Base title="Sailing Luwte" wfPage="65202d762b2142649c9d285a">
  <Fragment slot="head">
    <meta content="Luwte Amsterdam." name="description">
    <meta content="Zeilschip de Luwte" property="og:title">
    <meta content="https://luwte.amsterdam/wp-content/uploads/2024/03/Samenvatting_onderzoek_JS.jpg" property="og:image">
    <meta content="Zeilschip de Luwte" name="twitter:title">
    <meta content="https://luwte.amsterdam/wp-content/uploads/2024/03/Samenvatting_onderzoek_JS.jpg" name="twitter:image">
  </Fragment>
  
  <div class="hero-luwte">
    <div class="waves-section-hero-5">
      <div class="hero-gradient"></div>
      <div class="hero-container w-container">
        <div class="waves-title-wrap-hero-5">
          <h1 class="heading h1"><Fragment set:html={rich(home.heroHeading)} /></h1>
          <div class="waves---limit-480">
            <div class="subtitle-luwte"><Fragment set:html={rich(home.heroSubtitle)} /></div>
          </div>
          <div class="waves---mg-top-16">
            <a bind="d494e356-684f-1238-a5b9-3aeb88874299" href="/blog/" class="waves---cta-white wide-cta w-button">{home.heroCta}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="section cc-home-wrap">
    <div class="container">
      <div class="waves---section-medium">
        <div class="waves---main-container w-container">
          <div class="waves---sides-heading-button">
            <h2 class="waves---heading-2-no-margins-2">{home.shipSpecsHeading}</h2>
            <a bind="0f942300-235b-8576-30af-40139e54d858" href="/about.html" class="waves---cta-dark w-button">Meer over S.V. Luwte</a>
          </div>
          <div data-w-id="0f942300-235b-8576-30af-40139e54d85a" style="opacity:0" class="w-layout-grid waves---grid-features-7">
            <div id="w-node-_0f942300-235b-8576-30af-40139e54d85b-9c9d285a" class="waves-wide-tile-features-7">
              <div class="waves-inside-wide-feature-7">
                <h1 class="h3-luwte">{home.shipSpecs[0].title}</h1>
                <div class="text-normal"><Fragment set:html={rich(home.shipSpecs[0].body)} /></div>
              </div><img src="/images/Middel-11LUWTE-SQUARE-black-thin.png" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939.9874877929688px" srcset="/images/Middel-11LUWTE-SQUARE-black-thin-p-500.png 500w, /images/Middel-11LUWTE-SQUARE-black-thin-p-800.png 800w, /images/Middel-11LUWTE-SQUARE-black-thin-p-1080.png 1080w, /images/Middel-11LUWTE-SQUARE-black-thin-p-1600.png 1600w, /images/Middel-11LUWTE-SQUARE-black-thin-p-2000.png 2000w, /images/Middel-11LUWTE-SQUARE-black-thin.png 2746w" alt="" class="waves-image-wide-feature-7">
            </div>
            <div id="w-node-_0f942300-235b-8576-30af-40139e54d862-9c9d285a" class="waves-vertical-tile-features-7">
              <div class="waves-inside-tile-vertical-features-7">
                <h1 class="h3-luwte">{home.shipSpecs[1].title}</h1>
                <div class="text-block"><Fragment set:html={rich(home.shipSpecs[1].body)} /></div>
              </div>
            </div>
            <div class="waves-tile-small-feature-7">
              <h1 class="h3-luwte">{home.shipSpecs[2].title}</h1>
              <div class="text-normal"><Fragment set:html={rich(home.shipSpecs[2].body)} /></div>
            </div>
            <div class="waves-tile-small-feature-7">
              <h1 class="h3-luwte">{home.shipSpecs[3].title}</h1>
              <div class="text-normal"><Fragment set:html={rich(home.shipSpecs[3].body)} /></div>
            </div>
            <div class="waves-tile-small-feature-7">
              <h1 class="h3-luwte">{home.shipSpecs[4].title}</h1>
              <div class="text-normal"><Fragment set:html={rich(home.shipSpecs[4].body)} /></div>
            </div>
          </div>
        </div>
      </div>
      <div class="motto-wrap">
        <div class="waves---section-medium">
          <div class="waves---main-container w-container">
            <div class="waves---center-heading">
              <h2 class="h2-luwte">{home.crewHeading}</h2>
              <div class="sub-h-luwte"><Fragment set:html={rich(home.crewSubtitle)} /></div>
            </div>
            <div class="w-layout-grid waves-grid-team-1">
              <div id="w-node-_963bdfe1-7a76-284f-ab93-52ba569b20b4-9c9d285a" class="waves-tile-team-1"><img src="/images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.48.49_5722fd21.jpg" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939.9874877929688px" srcset="/images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.48.49_5722fd21-p-500.jpg 500w, /images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.48.49_5722fd21-p-800.jpg 800w, /images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.48.49_5722fd21-p-1080.jpg 1080w, /images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.48.49_5722fd21.jpg 1091w" alt="" class="waves-image-team-1">
                <div class="waves-name-wrap-team-1">
                  <div class="h3-luwte">{home.crewMembers[0].name}</div>
                  <div class="sub-h-luwte">{home.crewMembers[0].role}</div>
                </div>
              </div>
              <div id="w-node-fbae8e99-96a5-8782-6139-cff41b71b1c8-9c9d285a" class="waves-tile-team-1"><img src="/images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.44.24_d6146b86.jpg" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939.9874877929688px" srcset="/images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.44.24_d6146b86-p-500.jpg 500w, /images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.44.24_d6146b86-p-800.jpg 800w, /images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.44.24_d6146b86-p-1080.jpg 1080w, /images/Afbeelding-van-WhatsApp-op-2023-12-24-om-14.44.24_d6146b86.jpg 1200w" alt="" class="waves-image-team-1">
                <div class="waves-name-wrap-team-1">
                  <div class="h3-luwte">{home.crewMembers[1].name}</div>
                  <div class="sub-h-luwte">{home.crewMembers[1].role}</div>
                </div>
              </div>
            </div>
            <a bind="806a3733-215a-4eb2-aeb5-dc29f1fc1773" href="/about.html" class="waves---cta-dark w-button">Over ons</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="waves---section-medium-3">
    <div class="waves---main-container-3 w-container">
      <div class="w-layout-grid waves---grid-image-halves">
        <div bind="fc46b614-3374-7ec8-2066-70dba96cfeb8" id="w-node-fc46b614-3374-7ec8-2066-70dba96cfeb8-9c9d285a" class="html-embed donor w-embed w-script">
          <script is:inline async="" src="https://js.stripe.com/v3/buy-button.js">
</script>
          <stripe-buy-button buy-button-id="buy_btn_1P8KfJJPOFqeLCywdnBhWb1D" publishable-key="pk_live_Zfbd6J4q6lDPl4zc8aNgmqdr00TXiuyBux">
          </stripe-buy-button>
        </div>
        <div id="w-node-_5e64e13a-f09b-5315-35f3-e5ec7e1fa73d-9c9d285a" class="waves---content-image-halves">
          <h2 class="waves---heading-2-no-margins">{home.donationHeading}</h2>
          <div class="text-normal"><Fragment set:html={rich(home.donationText)} /></div>
          <div class="waves---mg-top-17">
            <div class="waves---master-checks-vertical">
              <div class="waves---single-check-item"><img src="/images/check.svg" loading="lazy" alt="" class="waves---check-icon">
                <div class="sub-h-luwte left">{home.donationChecklist[0]}</div>
              </div>
              <div class="waves---single-check-item"><img src="/images/check.svg" loading="lazy" alt="" class="waves---check-icon">
                <div class="sub-h-luwte left">{home.donationChecklist[1]}</div>
              </div>
              <div class="waves---single-check-item"><img src="/images/check.svg" loading="lazy" alt="" class="waves---check-icon">
                <div class="sub-h-luwte left">{home.donationChecklist[2]}</div>
              </div>
            </div>
          </div>
          <a href="#todo" bind="53c76b7e-4dba-9906-2b59-550c0fc911ac" class="waves---cta-dark left w-button">Bekijk bestemmingen</a>
        </div>
      </div>
    </div>
  </div>
  <div class="section cc-home-wrap">
    <div class="container">
      <div class="blog-heading">
        <div class="label cc-light">blog</div>
        <h2 class="h2-luwte">verhalen</h2>
      </div>
      <div class="collection-list-wrapper waves---section-medium w-dyn-list">
        <div role="list" class="collection-wrap waves---main-container w-dyn-items">
          {posts.slice(0, 4).map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </div>
    <a bind="786bc8f4-b84c-d379-7d8c-c42e69e9a401" href="/blog/" class="waves---cta-dark centering w-button">Meer verhalen</a>
  </div>
  <div class="waves---section-medium-3">
    <div class="waves---main-container-3 w-container">
      <div class="waves---center-heading">
        <h2 class="h2-luwte">{home.positionHeading}</h2>
        <div class="sub-h-luwte"><Fragment set:html={rich(home.positionText)} /></div>
      </div>
      <div bind="20e23897-0d5a-228a-12a5-40079a1b5f8e" id="w-node-_20e23897-0d5a-228a-12a5-40079a1b5f8e-9c9d285a" class="html-embed position w-embed w-script">
        <script is:inline type="text/javascript">
width='100%'; // the width of the embedded map in pixels or percentage
height='500'; // the height of the embedded map in pixels or percentage
border='0'; // the width of the border around the map (zero means no border)
shownames='false'; // to display ship names on the map (true or false)
latitude='37.4460'; // the latitude of the center of the map, in decimal degrees
longitude='24.9467'; // the longitude of the center of the map, in decimal degrees
zoom='9'; // the zoom level of the map (values between 2 and 17)
maptype='1'; // use 0 for Normal Map, 1 for Satellite, 2 for OpenStreetMap
trackvessel='244000141'; // MMSI of a vessel
</script>
        <script is:inline type="text/javascript" src="https://www.marinetraffic.com/js/embed.js"></script>
      </div>
    </div>
  </div>
  <section id="todo" class="section cc-home-wrap">
    <h1 class="h2-luwte">{home.destinationsHeading}</h1>
    <div class="sub-h-luwte">{home.destinationsSubtitle}</div>
    <div class="accordian-block">
      {destinations.items.map((d) => <Destination destination={d} />)}
    </div>
  </section>
  <script is:inline slot="end" src="/js/destinations.js"></script>
</Base>
