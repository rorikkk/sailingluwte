---
// Overview of the 2024/2025 voyage. Texts: src/data/reis.json (CMS: Pagina's › Reis '24/'25).
import Base from '../../layouts/Base.astro';
import reis from '../../data/reis.json';
import { rich } from '../../lib/utils';
const external = (url: string) => /^https?:\/\//.test(url);
---
<Base title={reis.title} wfPage="65202d762b2142649c9d285e">
  <Fragment slot="head">
    <meta content={reis.title} property="og:title">
    <meta content={reis.title} name="twitter:title">
  </Fragment>
  <div class="section cc-home-wrap">
    <div class="waves---section-hero-primary">
      <div class="waves---main-container w-container">
        <div class="w-layout-grid waves-grid-hero-1">
          <div id="w-node-ff529560-f826-e7bf-3735-e6cbb66d8785-9c9d285e" class="waves-content-hero-1">
            <h1 class="waves---mega-heading-1">{reis.heroHeading}</h1>
            <div class="waves---limit-480">
              <div class="waves---subtitle-2"><Fragment set:html={rich(reis.heroSubtitle)} /></div>
            </div>
            <div class="waves---mg-top-16">
              <a href="#onderdelen" class="waves---cta-dark wide-cta w-button">Bekijk de reis</a>
            </div>
          </div>
          <div id="w-node-ff529560-f826-e7bf-3735-e6cbb66d878e-9c9d285e" data-w-id="ff529560-f826-e7bf-3735-e6cbb66d878e" style="opacity:0" class="waves-gallery-hero-1">
