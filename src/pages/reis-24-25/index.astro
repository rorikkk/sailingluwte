                  <div class="waves-image-wrap-hero-1"><img src="/images/F9225053-3AE8-46FD-8722-0ACA34410722.JPG" loading="lazy" srcset="/images/F9225053-3AE8-46FD-8722-0ACA34410722-p-500.jpg 500w, /images/F9225053-3AE8-46FD-8722-0ACA34410722-p-800.jpg 800w, /images/F9225053-3AE8-46FD-8722-0ACA34410722-p-1080.jpg 1080w, /images/F9225053-3AE8-46FD-8722-0ACA34410722-p-1600.jpg 1600w, /images/F9225053-3AE8-46FD-8722-0ACA34410722-p-2000.jpg 2000w, /images/F9225053-3AE8-46FD-8722-0ACA34410722.JPG 2160w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
                </div>
                <div class="waves-item-gallery-hero-1">
                  <div class="waves-image-wrap-hero-1"><img src="/images/2055dfc8-f430-4bab-bc9c-f0731b5a2349.JPG" loading="lazy" srcset="/images/2055dfc8-f430-4bab-bc9c-f0731b5a2349-p-500.jpg 500w, /images/2055dfc8-f430-4bab-bc9c-f0731b5a2349-p-800.jpg 800w, /images/2055dfc8-f430-4bab-bc9c-f0731b5a2349-p-1080.jpg 1080w, /images/2055dfc8-f430-4bab-bc9c-f0731b5a2349-p-1600.jpg 1600w, /images/2055dfc8-f430-4bab-bc9c-f0731b5a2349.JPG 2048w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
                  <div class="waves-image-wrap-hero-1"><img src="/images/IMG_5029.jpg" loading="lazy" srcset="/images/IMG_5029-p-500.jpg 500w, /images/IMG_5029-p-800.jpg 800w, /images/IMG_5029-p-1080.jpg 1080w, /images/IMG_5029-p-1600.jpg 1600w, /images/IMG_5029-p-2000.jpg 2000w, /images/IMG_5029-p-2600.jpg 2600w, /images/IMG_5029.jpg 3024w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
                  <div class="waves-image-wrap-hero-1"><img src="/images/IMG20220622141840.jpg" loading="lazy" srcset="/images/IMG20220622141840-p-500.jpg 500w, /images/IMG20220622141840-p-800.jpg 800w, /images/IMG20220622141840-p-1080.jpg 1080w, /images/IMG20220622141840-p-1600.jpg 1600w, /images/IMG20220622141840-p-2000.jpg 2000w, /images/IMG20220622141840-p-2600.jpg 2600w, /images/IMG20220622141840.jpg 3072w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
                </div>
              </div>
            </div>
            <div class="waves-gradient-hero-1 bottom"></div>
          </div>
        </div>
      </div>
    </div>
    <div id="onderdelen" class="waves---section-medium">
      <div class="waves---main-container w-container">
        <div class="reis-tiles">
          {reis.tiles.map((tile) => (
            <div class="waves-tile-features-2 reis-tile">
              <div class="waves---mg-bottom-16"><img src="/images/Waves-Icon.svg" loading="lazy" alt="" class="waves-icon-32"></div>
              <h2 class="h3-luwte">{tile.title}</h2>
              <div class="text-normal"><Fragment set:html={rich(tile.text)} /></div>
              <a href={tile.url} target={external(tile.url) ? '_blank' : undefined} rel={external(tile.url) ? 'noopener' : undefined} class="waves---cta-dark w-button reis-tile-button">{tile.buttonText}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>
