              <div class="waves-inside-hero-1">
                <div class="waves-item-gallery-hero-1">
                  <div class="waves-image-wrap-hero-1"><img src="/images/IMG20220917124559.jpg" loading="lazy" srcset="/images/IMG20220917124559-p-500.jpg 500w, /images/IMG20220917124559-p-800.jpg 800w, /images/IMG20220917124559-p-1080.jpg 1080w, /images/IMG20220917124559-p-1600.jpg 1600w, /images/IMG20220917124559-p-2000.jpg 2000w, /images/IMG20220917124559-p-2600.jpg 2600w, /images/IMG20220917124559-p-3200.jpg 3200w, /images/IMG20220917124559.jpg 4096w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
                  <div class="waves-image-wrap-hero-1"><img src="/images/0CE7D97A-2721-48C9-8930-2A571BBAD03C.JPG" loading="lazy" srcset="/images/0CE7D97A-2721-48C9-8930-2A571BBAD03C-p-500.jpg 500w, /images/0CE7D97A-2721-48C9-8930-2A571BBAD03C-p-800.jpg 800w, /images/0CE7D97A-2721-48C9-8930-2A571BBAD03C-p-1080.jpg 1080w, /images/0CE7D97A-2721-48C9-8930-2A571BBAD03C-p-1600.jpg 1600w, /images/0CE7D97A-2721-48C9-8930-2A571BBAD03C-p-2000.jpg 2000w, /images/0CE7D97A-2721-48C9-8930-2A571BBAD03C-p-2600.jpg 2600w, /images/0CE7D97A-2721-48C9-8930-2A571BBAD03C-p-3200.jpg 3200w, /images/0CE7D97A-2721-48C9-8930-2A571BBAD03C.JPG 3264w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
                  <div class="waves-image-wrap-hero-1"><img src="/images/IMG-20200401-WA0008.jpg" loading="lazy" srcset="/images/IMG-20200401-WA0008-p-500.jpg 500w, /images/IMG-20200401-WA0008.jpg 768w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
                </div>
                <div class="waves-item-gallery-hero-1">
                  <div class="waves-image-wrap-hero-1"><img src="/images/amsterdam.jpg" loading="lazy" srcset="/images/amsterdam-p-500.jpg 500w, /images/amsterdam-p-800.jpg 800w, /images/amsterdam-p-1080.jpg 1080w, /images/amsterdam-p-1600.jpg 1600w, /images/amsterdam.jpg 1920w" sizes="(max-width: 479px) 100vw, (max-width: 767px) 40vw, 264px" alt="" class="waves-image-hero-1"></div>
